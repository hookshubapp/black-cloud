# Copy to .env.local for local development. On AWS Amplify, set these under
# Hosting > Environment variables instead.

# Where contact-form inquiries are delivered (comma-separate several addresses).
INQUIRY_TO_EMAIL=info@example.com
# Sender address; must be a verified identity in Amazon SES.
INQUIRY_FROM_EMAIL=no-reply@example.com
# AWS region where the SES identities are verified.
SES_REGION=eu-central-1
# Public URL of the site, used for social-share metadata.
NEXT_PUBLIC_SITE_URL=https://www.example.com
